<?php

/**
 * @file
 * Install, update and uninstall functions for the Live Files module.
 */

use Drupal\Core\Cache\Cache;
use Drupal\Core\Url;

/**
 * Implements hook_install().
 */
function live_files_install() {
  Cache::invalidateTags(['rendered']);
}

/**
 * Implements hook_uninstall().
 */
function live_files_uninstall() {
  Cache::invalidateTags(['rendered']);
}

/**
 * Implements hook_requirements().
 */
function live_files_requirements($phase) {
  $requirements = [];
  if ($phase === 'runtime') {
    $config = \Drupal::config('live_files.settings');
    $base_url = $config->get('base_url');
    $value = $base_url ?: t('Not configured');
    if ($base_url && ($config->get('auth_username') ?? '') !== '') {
      $value = t('@url (HTTP authentication)', ['@url' => $base_url]);
    }
    $requirements['live_files'] = [
      'title' => t('Live files'),
      'value' => $value,
      'description' => $base_url
        ? t('Files are being served from the live site. This module is meant for local development and should not be enabled on production.')
        : t('Enter the live site URL on the <a href=":url">settings page</a>.', [':url' => Url::fromRoute('live_files.settings')->toString()]),
      'severity' => REQUIREMENT_WARNING,
    ];
  }
  return $requirements;
}

/**
 * Add HTTP basic authentication settings.
 */
function live_files_update_10001() {
  $config = \Drupal::configFactory()->getEditable('live_files.settings');
  $config
    ->set('auth_username', (string) ($config->get('auth_username') ?? ''))
    ->set('auth_password', (string) ($config->get('auth_password') ?? ''))
    ->save();
}
